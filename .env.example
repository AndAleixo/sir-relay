# =============================================================================
# SirRelay — .env · docs/ENVIRONMENTS.md
# Escolhe UM bloco. Comenta os outros.
# DATABASE_URL: não precisas (compose/scripts injectam).
# =============================================================================


# ─── 1 · DEV MOCK — npm run dev-mock ────────────────────────────────────────
# NEXT_PUBLIC_SERVICE_MODE=mock
# APP_URL=http://localhost:3000
#
# Login: sam@example.com · ana@example.com · qualquer password


# ─── 2 · PROD LOCAL — npm run prod-local ────────────────────────────────────
# NEXT_PUBLIC_SERVICE_MODE=api
# POSTGRES_PASSWORD=senha_forte_local
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# APP_DOMAIN=localhost
# APP_URL=http://localhost
# PLATFORM_ADMIN_USERNAME=ops
# PLATFORM_ADMIN_PASSWORD=change-me-min-8-chars
# CONTACT_EMAIL=contact@sirrelay.com
# MAIL_API_KEY=
# MAIL_FROM=noreply@sirrelay.com
# UMAMI_APP_SECRET=generate-with-openssl-rand-hex-32
# UMAMI_WEBSITE_ID=


# ─── 3 · PROD VPS — bash scripts/env/prod-vps.sh ────────────────────────────
# NEXT_PUBLIC_SERVICE_MODE=api
# POSTGRES_PASSWORD=senha_forte_producao
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# APP_DOMAIN=app.sirrelay.com
# APP_ROOT_DOMAIN=sirrelay.com
# APP_URL=https://app.sirrelay.com
# CADDY_EMAIL=admin@sirrelay.com
# CONTACT_EMAIL=contact@sirrelay.com
# MAIL_API_KEY=
# MAIL_FROM=noreply@sirrelay.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# ADMIN_EMAIL=ops@sirrelay.com
# ADMIN_PASSWORD=...
# PLATFORM_ADMIN_USERNAME=ops
# PLATFORM_ADMIN_PASSWORD=change-me-min-8-chars
# UMAMI_APP_SECRET=generate-with-openssl-rand-hex-32
# UMAMI_WEBSITE_ID=
