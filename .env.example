# =============================================================================
# SirRelay — environment template (4 environments)
# See docs/ENVIRONMENTS.md
#
#   1. Dev mock      → .env.local   · npm run dev
#   2. Dev híbrido   → .env.local   · postgres docker + npm run dev
#   3. Prod local    → .env         · docker compose up
#   4. Prod VPS      → .env         · docker compose on Droplet
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DEV MOCK — maqueta (current default, UI polish & demo)
# Copy to .env.local · run: npm run dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SERVICE_MODE=mock

# Offline sync retry delays — mock only (milliseconds)
NEXT_PUBLIC_SYNC_RETRY_INITIAL_MS=3000
NEXT_PUBLIC_SYNC_RETRY_INTERVAL_MS=10000

# -----------------------------------------------------------------------------
# 2. DEV HÍBRIDO — oficina (Postgres + npm run dev + API services)
# Copy to .env.local
# Start DB: docker compose -f docker-compose.yml -f docker-compose.dev.yml up postgres -d
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SERVICE_MODE=api
# DATABASE_URL=postgresql://sirrelay:DEV_PASSWORD@localhost:5432/sirrelay
# SESSION_SECRET=generate-with-openssl-rand-base64-32
# APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3. PROD LOCAL — test drive (docker compose on your machine)
# Copy to .env · APP_URL=http://app.local · APP_DOMAIN=app.local
# Run: docker compose up -d --build
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SERVICE_MODE=api
# APP_URL=http://app.local
# APP_DOMAIN=app.local
# POSTGRES_PASSWORD=
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 4. PROD VPS — estrada (DigitalOcean Droplet)
# Copy to .env on server · VPS guide: docs/DEPLOY-DIGITALOCEAN.md
# Run: docker compose up -d --build
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SERVICE_MODE=api
# APP_URL=https://app.your-domain.com
# APP_DOMAIN=app.your-domain.com
# CADDY_EMAIL=admin@your-domain.com
# POSTGRES_PASSWORD=
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# DATABASE_URL is set automatically in docker-compose.yml:
#   postgresql://sirrelay:${POSTGRES_PASSWORD}@postgres:5432/sirrelay

# --- Phase 2 analytics (optional, self-hosted Umami/Plausible) ---
# ANALYTICS_ENABLED=false
# ANALYTICS_SCRIPT_URL=
# ANALYTICS_SITE_ID=
