# UI mock phase — defaults to mock services
NEXT_PUBLIC_SERVICE_MODE=mock

# Offline sync retry delays (milliseconds)
NEXT_PUBLIC_SYNC_RETRY_INITIAL_MS=3000
NEXT_PUBLIC_SYNC_RETRY_INTERVAL_MS=10000

# --- Phase 1 production (not used in mock) ---
