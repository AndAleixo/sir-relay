# UI mock phase — defaults to mock services
NEXT_PUBLIC_SERVICE_MODE=mock

# Offline sync retry delays (milliseconds)
NEXT_PUBLIC_SYNC_RETRY_INITIAL_MS=3000
NEXT_PUBLIC_SYNC_RETRY_INTERVAL_MS=10000

# --- Phase 1 production (DigitalOcean + Docker Compose) ---
# APP_URL=https://app.your-domain.com
# APP_DOMAIN=app.your-domain.com
# CADDY_EMAIL=admin@your-domain.com
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://sirrelay:POSTGRES_PASSWORD@postgres:5432/sirrelay
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# --- Phase 2 analytics (optional, self-hosted Umami/Plausible) ---
# ANALYTICS_ENABLED=false
# ANALYTICS_SCRIPT_URL=
# ANALYTICS_SITE_ID=
