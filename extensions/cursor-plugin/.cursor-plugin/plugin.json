{
  "name": "sirrelay",
  "version": "1.1.1",
  "description": "Manage SirRelay tasks from the agent — list, create, update, and delete on your board.",
  "author": {
    "name": "Andre Aleixo"
  },
  "homepage": "https://app.sirrelay.com",
  "repository": "https://github.com/AndAleixo/sir-relay",
  "license": "FSL-1.1-MIT",
  "keywords": ["sirrelay", "srelay", "tasks", "mcp", "todo"],
  "logo": "assets/logo.svg",
  "variables": {
    "type": "object",
    "properties": {
      "SIRRELAY_TOKEN": {
        "type": "string",
        "title": "Link token",
        "description": "From SirRelay → Profile → Editor & MCP key (or Link this editor). Treat like a password."
      },
      "SIRRELAY_URL": {
        "type": "string",
        "title": "App origin",
        "description": "SirRelay origin with no path.",
        "default": "https://app.sirrelay.com"
      }
    },
    "required": ["SIRRELAY_TOKEN"]
  }
}
