{
  "name": "sirrelay",
  "displayName": "SRelay",
  "description": "Organize your own work, or a group's. Your tasks stay in the sidebar.",
  "version": "1.1.0",
  "publisher": "sirrelay",
  "license": "FSL-1.1-MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndAleixo/sir-relay.git"
  },
  "bugs": {
    "url": "https://github.com/AndAleixo/sir-relay/issues"
  },
  "homepage": "https://app.sirrelay.com",
  "keywords": ["srelay", "tasks", "todo"],
  "qna": "marketplace",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onView:sirrelay.board", "onUri"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sirrelay",
          "title": "SRelay",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sirrelay": [
        {
          "type": "webview",
          "id": "sirrelay.board",
          "name": "My work",
          "retainContextWhenHidden": true
        }
      ]
    },
    "commands": [
      {
        "command": "sirrelay.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "sirrelay.openSite",
        "title": "Open on SRelay",
        "icon": "$(link-external)"
      },
      {
        "command": "sirrelay.signOut",
        "title": "Sign out",
        "icon": "$(sign-out)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sirrelay.refresh",
          "when": "view == sirrelay.board",
          "group": "navigation@1"
        },
        {
          "command": "sirrelay.openSite",
          "when": "view == sirrelay.board",
          "group": "navigation@2"
        },
        {
          "command": "sirrelay.signOut",
          "when": "view == sirrelay.board && sirrelay.signedIn",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "SRelay",
      "properties": {
        "sirrelay.url": {
          "type": "string",
          "default": "https://app.sirrelay.com",
          "description": "Origin of the SRelay app, with no path."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "package": "npm run compile && mkdir -p dist && npx --yes @vscode/vsce package --out dist/sirrelay.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.3"
  }
}
