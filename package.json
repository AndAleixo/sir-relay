{
  "name": "sir-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:routes": "node scripts/check-entry-routes.mjs",
    "check:teammates": "tsx scripts/check-teammate-lifecycle.ts",
    "check:telegram": "node scripts/check-telegram-link.mjs",
    "check:queue": "tsx scripts/check-task-queue-order.ts",
    "check:sec": "tsx scripts/check-sec-base.ts",
    "dev-mock": "bash scripts/env/dev-mock.sh",
    "dev-hybrid": "bash scripts/env/dev-hybrid.sh",
    "dev-hybrid-db": "bash scripts/env/dev-hybrid-db.sh",
    "dev-hybrid-db-down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "prod-local": "bash scripts/env/prod-local.sh",
    "prod-local-down": "docker compose -f docker-compose.yml -f docker-compose.local.yml down",
    "prod-local-logs": "docker compose -f docker-compose.yml -f docker-compose.local.yml logs -f app caddy",
    "prod-vps": "bash scripts/env/prod-vps.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "grammy": "^1.44.0",
    "jose": "^6.2.3",
    "next": "^14.2.18",
    "next-intl": "^3.23.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3"
  }
}
