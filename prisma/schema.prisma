generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  operator
  teammate
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskDifficulty {
  easy
  medium
  hard
}

enum Locale {
  en
  es
  pt
}

enum AccountStatus {
  invited
  active
}

enum OperatorAlertType {
  task_done
  task_due
}

enum GroupInvitationStatus {
  pending
  accepted
  declined
}

enum AuditActorType {
  operator
  teammate
  system
}

enum TelegramActivitySource {
  telegram
}

model User {
  id                 String        @id
  name               String
  email              String        @unique
  passwordHash       String?       @map("password_hash")
  locale             Locale        @default(en)
  telegramChatId     String?       @map("telegram_chat_id")
  active             Boolean       @default(true)
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  accountStatus      AccountStatus @default(active) @map("account_status")
  lastActiveGroupId  String?       @map("last_active_group_id")
  tokenVersion       Int           @default(0) @map("token_version")
  failedLoginCount   Int           @default(0) @map("failed_login_count")
  lockedUntil        DateTime?     @map("locked_until")
  /** Canonical English legal pack version from legal/en.json (null = never accepted). */
  termsVersion       String?       @map("terms_version")
  termsAcceptedAt    DateTime?     @map("terms_accepted_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  memberships        GroupMembership[]
  ownedGroups        Group[]           @relation("GroupOwner")
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  inviteTokens       TeammateInviteToken[]
  telegramLinkTokens TelegramLinkToken[]
  sentGroupInvitations     GroupInvitation[] @relation("GroupInvitationSender")
  receivedGroupInvitations GroupInvitation[] @relation("GroupInvitationRecipient")
  telegramActivities       TelegramActivity[]
  auditLogs                AuditLog[]

  @@map("users")
}

model Group {
  id          String   @id
  name        String
  ownerUserId String   @map("owner_user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User              @relation("GroupOwner", fields: [ownerUserId], references: [id])
  memberships GroupMembership[]
  tasks       Task[]
  alertPrefs  GroupAlertPrefs?
  alerts      OperatorAlert[]
  inviteTokens TeammateInviteToken[]
  invitations  GroupInvitation[]
  telegramActivities TelegramActivity[]
  auditLogs   AuditLog[]
  projects    Project[]

  @@map("groups")
}

model GroupMembership {
  groupId     String   @map("group_id")
  userId      String   @map("user_id")
  role        Role
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_memberships")
}

model GroupInvitation {
  id              String                @id @default(cuid())
  groupId         String                @map("group_id")
  invitedUserId   String                @map("invited_user_id")
  invitedByUserId String                @map("invited_by_user_id")
  status          GroupInvitationStatus @default(pending)
  expiresAt       DateTime              @map("expires_at")
  respondedAt     DateTime?             @map("responded_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUser User  @relation("GroupInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("GroupInvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([groupId, status])
  @@map("group_invitations")
}

model Task {
  id                   String     @id
  groupId              String     @map("group_id")
  title                String
  description          String     @default("")
  assigneeId           String     @map("assignee_id")
  createdById          String     @map("created_by_id")
  status               TaskStatus      @default(todo)
  difficulty           TaskDifficulty?
  dueDate              DateTime?       @map("due_date") @db.Date
  telegramMessageId    String?    @map("telegram_message_id")
  telegramChatId       String?    @map("telegram_chat_id")
  telegramNotifiedAt   DateTime?  @map("telegram_notified_at")
  telegramNotifyFailed Boolean    @default(false) @map("telegram_notify_failed")
  sortOrder            Int        @default(0) @map("sort_order")
  projectId            String?    @map("project_id")
  categoryId           String?    @map("category_id")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignee User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User     @relation("TaskCreator", fields: [createdById], references: [id])
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  telegramActivities TelegramActivity[]

  @@index([groupId])
  @@index([assigneeId])
  @@index([groupId, assigneeId, sortOrder])
  @@index([projectId])
  @@index([categoryId])
  @@map("tasks")
}

model Project {
  id         String    @id @default(cuid())
  groupId    String    @map("group_id")
  name       String    @db.VarChar(20)
  acronym    String    @db.VarChar(3)
  archivedAt DateTime? @map("archived_at")
  pendingAt  DateTime? @map("pending_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tasks Task[]
  categories ProjectCategory[]

  // Open-acronym uniqueness is the partial index in
  // prisma/migrations/20260815120000_group_projects (not @@unique — reuse after archive).
  @@index([groupId])
  @@map("projects")
}

model ProjectCategory {
  id         String    @id @default(cuid())
  projectId  String    @map("project_id")
  name       String    @db.VarChar(20)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  // Open-name uniqueness is the partial index in
  // prisma/migrations/20260920120000_project_categories (lower(name); reuse after archive).
  @@index([projectId])
  @@map("project_categories")
}

model TeammateInviteToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  groupId   String    @map("group_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([userId, groupId])
  @@map("teammate_invite_tokens")
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("telegram_link_tokens")
}

model GroupAlertPrefs {
  groupId         String  @id @map("group_id")
  taskDone        Boolean @default(true) @map("task_done")
  taskDue         Boolean @default(true) @map("task_due")
  timezone        String  @default("UTC")
  quietHoursStart Int?    @map("quiet_hours_start")
  quietHoursEnd   Int?    @map("quiet_hours_end")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_alert_prefs")
}

model OperatorAlert {
  id               String            @id @default(cuid())
  groupId          String            @map("group_id")
  type             OperatorAlertType
  taskId           String            @map("task_id")
  taskTitle        String            @map("task_title")
  assigneeName     String            @map("assignee_name")
  dueDate          DateTime?         @map("due_date") @db.Date
  sentToTelegram   Boolean           @default(false) @map("sent_to_telegram")
  createdAt        DateTime          @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt(sort: Desc)])
  @@map("operator_alerts")
}

model TelegramActivity {
  id        String                  @id @default(cuid())
  groupId   String                  @map("group_id")
  taskId    String                  @map("task_id")
  userId    String                  @map("user_id")
  body      String
  source    TelegramActivitySource  @default(telegram)
  createdAt DateTime                @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
  @@index([groupId])
  @@map("telegram_activity")
}

model AuditLog {
  id        String         @id @default(cuid())
  groupId   String?        @map("group_id")
  action    String
  actorType AuditActorType @map("actor_type")
  actorId   String?        @map("actor_id")
  metadata  Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at")

  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
